  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:integration": "firebase emulators:exec --config ../firebase.json --project rio-en-alerta-sanfernando --only firestore \"node --test test-emulator/firestore.integration.js\"",
